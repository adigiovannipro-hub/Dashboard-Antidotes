# ---------------------------------------------------------------------------
# Antidotes — variables d'environnement
# Copier ce fichier en `.env.local` et renseigner les valeurs.
# `.env.local` est ignoré par git : aucun secret ne doit être commité.
# ---------------------------------------------------------------------------

# --- Supabase -------------------------------------------------------------
# Dashboard Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clé `service_role`. SERVEUR UNIQUEMENT — contourne la RLS.
# Ne jamais préfixer NEXT_PUBLIC_, ne jamais l'exposer au navigateur.
SUPABASE_SERVICE_ROLE_KEY=

# --- Application ----------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Clé de chiffrement des tokens d'API stockés en base (AES-256-GCM).
# Générer avec : openssl rand -base64 32
CREDENTIALS_ENCRYPTION_KEY=

# Secret protégeant la route de synchronisation appelée par le cron.
# Générer avec : openssl rand -hex 32
CRON_SECRET=

# --- Meta (Facebook / Instagram) ------------------------------------------
# App créée sur developers.facebook.com — voir docs/meta-setup.md
META_APP_ID=
META_APP_SECRET=

# Token longue durée de l'utilisateur système du Business Manager.
# Porte l'accès à tous les comptes clients partagés en partner access.
META_SYSTEM_USER_TOKEN=

# Version de la Graph API ciblée.
META_API_VERSION=v23.0

# --- Monday.com (module Planning Édito) -----------------------------------
# Jeton personnel d'API : avatar > Développeurs > Mes jetons d'accès.
# Sans lui, le module affiche ce qui est déjà en base et le push reste en file
# d'attente ; rien ne casse.
MONDAY_API_TOKEN=

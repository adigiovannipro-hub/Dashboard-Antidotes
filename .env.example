# ---------------------------------------------------------------------------
# Antidotes — variables d'environnement
# Copier ce fichier en `.env.local` et renseigner les valeurs.
# `.env.local` est ignoré par git : aucun secret ne doit être commité.
# ---------------------------------------------------------------------------

# --- Supabase -------------------------------------------------------------
# Dashboard Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clé `service_role`. SERVEUR UNIQUEMENT — contourne la RLS.
# Ne jamais préfixer NEXT_PUBLIC_, ne jamais l'exposer au navigateur.
SUPABASE_SERVICE_ROLE_KEY=

# --- Application ----------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Authentification. Absente ou à autre chose que `true`, l'application est
# OUVERTE : aucune connexion demandée, et toute personne ayant l'URL voit
# l'ensemble des espaces — plannings, budgets, captions, chiffres.
# Mettre `true` pour exiger le magic link et rétablir l'isolation par la RLS.
ANTIDOTES_OPEN_ACCESS=

# Clé de chiffrement des tokens d'API stockés en base (AES-256-GCM).
# Générer avec : openssl rand -base64 32
CREDENTIALS_ENCRYPTION_KEY=

# Secret protégeant la route de synchronisation appelée par le cron.
# Générer avec : openssl rand -hex 32
CRON_SECRET=

# Déclenchement de la synchronisation Airwallex depuis l'application.
# Airwallex refuse les adresses IP de l'hébergeur : la collecte tourne sur une
# machine GitHub. Ce jeton sert à lancer le workflow `airwallex-sync.yml` quand
# on ouvre Finance ou Échéances — sans lui, le fond de tâche horaire continue,
# mais les deux écrans ne peuvent plus se rafraîchir à la demande et le disent.
#
# Jeton à portée fine (github.com/settings/personal-access-tokens) :
#   Repository access → ce dépôt seulement
#   Permissions → Actions : Read and write, Metadata : Read-only
# À poser sur Vercel (Settings → Environment Variables), pas seulement en local.
GITHUB_SYNC_TOKEN=

# Dépôt et branche visés, si l'on travaille sur un fork ou un miroir.
# Par défaut : adigiovannipro-hub/dashboard-antidotes, branche main — un
# `workflow_dispatch` doit viser la même branche que le passage programmé.
GITHUB_SYNC_REPO=
GITHUB_SYNC_REF=

# --- Meta (Facebook / Instagram) ------------------------------------------
# App créée sur developers.facebook.com — voir docs/meta-setup.md
META_APP_ID=
META_APP_SECRET=

# Token longue durée de l'utilisateur système du Business Manager.
# Porte l'accès à tous les comptes clients partagés en partner access.
META_SYSTEM_USER_TOKEN=

# Version de la Graph API ciblée.
META_API_VERSION=v23.0

# --- Module Reçus ---------------------------------------------------------
# Chaîne mail → facture → Airwallex. Voir docs/recus-setup.md.

# Identifiants OAuth du projet Google Cloud, Gmail API activée.
# Portées demandées : gmail.readonly, gmail.send, userinfo.email — pas plus.
# URI de redirection à déclarer : <SITE_URL>/api/recus/connexion/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Airwallex — Account settings > Developer > API keys.
# Les ressources Spend exigent des droits au niveau organisation.
AIRWALLEX_CLIENT_ID=
AIRWALLEX_API_KEY=

# `demo` (bac à sable) ou `production`. Une chaîne comptable se teste ailleurs
# qu'en production : la valeur par défaut est volontairement le bac à sable.
AIRWALLEX_ENV=demo

# Lecture des factures par le modèle. Facultative : sans elle, le classement
# retombe sur des règles simples, à confiance plafonnée — donc sans aucun
# transfert automatique possible.
ANTHROPIC_API_KEY=

# --- Academy ----------------------------------------------------------------
# L'espace de formation `/academy` n'a aucune variable à lui : il vit sur les
# clés Supabase ci-dessus. La clé `service_role` sert à signer les URL des
# vidéos hébergées dans le bucket privé `academy-videos` (6 h de validité),
# toujours côté serveur et après vérification du droit de lecture.

# --- Monday.com (reprise du Planning Éditorial) ----------------------------
# Jeton personnel d'API : avatar > Développeurs > Mes jetons d'accès.
# Utilisé uniquement par `pnpm import:monday`, pour reprendre une année déjà
# saisie. L'application n'interroge jamais Monday : sans ce jeton, tout
# fonctionne, seul l'import est indisponible.
MONDAY_API_TOKEN=

# --- Fathom (tâches de fin de réunion → « Mon travail ») --------------------
# Clé de l'API externe : Settings > Integrations > API. Sans elle, l'étape
# Fathom du cron quotidien ne s'exécute pas et le dit ; le reste — ligne
# quotidienne, cycles clients — continue de tourner.
FATHOM_API_KEY=

# Reprise d'historique, `YYYY-MM-DD`. Absente, la synchronisation regarde les
# trente derniers jours. À poser une fois pour rattraper des réunions plus
# anciennes, puis à retirer : rejouer les mêmes réunions n'écrit rien, chaque
# tâche portant une clé d'idempotence.
FATHOM_IMPORT_SINCE=

# À qui reviennent les tâches. Par défaut, celui qui a enregistré la réunion —
# dans un compte solo, toujours la bonne personne. À renseigner le jour où
# quelqu'un d'autre enregistre pour le compte.
FATHOM_OWNER_EMAIL=
FATHOM_OWNER_NAME=
# --- Composio (passerelle de connecteurs) ---------------------------------
# Clé de projet Platform, dashboard.composio.dev > Platform > projet >
# Getting Started. Elle commence par `ak_`. SERVEUR UNIQUEMENT : elle donne
# accès à tous les comptes connectés du projet — ne jamais la préfixer
# NEXT_PUBLIC_.
#
# La clé `ck_` de « Composio For You » n'est PAS interchangeable : elle sert
# aux clients MCP (Claude Desktop), pas au SDK d'une application.
COMPOSIO_API_KEY=

# Identité sous laquelle les comptes sont connectés chez Composio. Antidotes
# utilise l'UUID de l'espace client (`workspaces.id`), pour qu'un compte Meta
# ou LinkedIn reste rattaché au client auquel il appartient. Cette variable ne
# sert qu'aux scripts joués à la main, quand aucun espace n'est en contexte.
COMPOSIO_DEFAULT_USER_ID=

# --- Academy : courriel d'arrivée des élèves ---------------------------------
# Facteur du message qui ouvre l'accès à une formation (Resend, 3 000 messages
# par mois en gratuit). Sans la clé, l'inscription se fait quand même et le
# lien d'accès s'affiche à l'écran, à envoyer à la main.
RESEND_API_KEY=
# Expéditeur affiché. Le domaine doit être vérifié chez Resend ; sans domaine
# vérifié, laisser vide — le défaut `onboarding@resend.dev` ne poste qu'à
# l'adresse du compte Resend, ce qui suffit pour un essai.
ACADEMY_EMAIL_FROM=

# ---------------------------------------------------------------------------
# Antidotes — variables d'environnement
# Copier ce fichier en `.env.local` et renseigner les valeurs.
# `.env.local` est ignoré par git : aucun secret ne doit être commité.
# ---------------------------------------------------------------------------

# --- Supabase -------------------------------------------------------------
# Dashboard Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clé `service_role`. SERVEUR UNIQUEMENT — contourne la RLS.
# Ne jamais préfixer NEXT_PUBLIC_, ne jamais l'exposer au navigateur.
SUPABASE_SERVICE_ROLE_KEY=

# --- Application ----------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Authentification. Absente ou à autre chose que `true`, l'application est
# OUVERTE : aucune connexion demandée, et toute personne ayant l'URL voit
# l'ensemble des espaces — plannings, budgets, captions, chiffres.
# Mettre `true` pour exiger le magic link et rétablir l'isolation par la RLS.
ANTIDOTES_OPEN_ACCESS=

# Clé de chiffrement des tokens d'API stockés en base (AES-256-GCM).
# Générer avec : openssl rand -base64 32
CREDENTIALS_ENCRYPTION_KEY=

# Secret protégeant la route de synchronisation appelée par le cron.
# Générer avec : openssl rand -hex 32
CRON_SECRET=

# --- Meta (Facebook / Instagram) ------------------------------------------
# App créée sur developers.facebook.com — voir docs/meta-setup.md
META_APP_ID=
META_APP_SECRET=

# Token longue durée de l'utilisateur système du Business Manager.
# Porte l'accès à tous les comptes clients partagés en partner access.
META_SYSTEM_USER_TOKEN=

# Version de la Graph API ciblée. À remonter une fois par an : les versions
# de la Marketing API ne vivent qu'environ un an (la v23.0 est morte en
# juin 2026).
META_API_VERSION=v25.0

# --- Module Reçus ---------------------------------------------------------
# Chaîne mail → facture → Airwallex. Voir docs/recus-setup.md.

# Identifiants OAuth du projet Google Cloud, Gmail API activée.
# Portées demandées : gmail.readonly, gmail.send, userinfo.email — pas plus.
# URI de redirection à déclarer : <SITE_URL>/api/recus/connexion/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Airwallex — Account settings > Developer > API keys.
# Les ressources Spend exigent des droits au niveau organisation.
AIRWALLEX_CLIENT_ID=
AIRWALLEX_API_KEY=

# `demo` (bac à sable) ou `production`. Une chaîne comptable se teste ailleurs
# qu'en production : la valeur par défaut est volontairement le bac à sable.
AIRWALLEX_ENV=demo

# Lecture des factures par le modèle. Facultative : sans elle, le classement
# retombe sur des règles simples, à confiance plafonnée — donc sans aucun
# transfert automatique possible.
ANTHROPIC_API_KEY=

# --- Monday.com (reprise du Planning Éditorial) ----------------------------
# Jeton personnel d'API : avatar > Développeurs > Mes jetons d'accès.
# Utilisé uniquement par `pnpm import:monday`, pour reprendre une année déjà
# saisie. L'application n'interroge jamais Monday : sans ce jeton, tout
# fonctionne, seul l'import est indisponible.
MONDAY_API_TOKEN=
